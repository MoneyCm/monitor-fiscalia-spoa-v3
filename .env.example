# Socrata (opcional, recomendado para mayor cuota)
# Lotes de 10k evitan ReadTimeout en datos.gov.co; 6 reintentos con backoff
# toleran ventanas de lentitud sin tumbar el run (fallback a snapshot).
SOCRATA_APP_TOKEN=
SOCRATA_TIMEOUT_SECONDS=90
SOCRATA_PAGE_SIZE=10000
SOCRATA_MAX_RETRIES=6
SOCRATA_RETRY_BACKOFF=2.0

# Correo SMTP (Gmail requiere contraseña de aplicación)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SPOA_RECIPIENTS=secretaria.seguridad@jamundi.gov.co,forecesar@gmail.com

# Integración con SISC. En GitHub Actions se prefiere OIDC; la clave es respaldo local.
SISC_API_URL=https://sisc-backend.onrender.com/api
SISC_SOURCE_MONITOR_KEY=
SISC_SYNC_ENABLED=true
SISC_DASHBOARD_URL=https://sisc-frontend.onrender.com

# Operación
SPOA_STATE_DIR=state
SPOA_DATA_DIR=data
SPOA_OUTPUT_DIR=output
SPOA_LOG_LEVEL=INFO

